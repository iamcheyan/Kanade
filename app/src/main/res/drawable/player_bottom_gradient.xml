<?xml version="1.0" encoding="utf-8"?>
<!--
  Faint darkening behind the progress row so white text stays readable over a
  bright frame. A gradient rather than a solid block keeps the video visible.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:endColor="#00000000"
        android:startColor="#99000000" />
</shape>
